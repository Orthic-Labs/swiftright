{
  "launchArgs": [
    "--fixture",
    "F8"
  ],
  "steps": [
    {
      "id": "initial",
      "logicalAction": "launch-and-snapshot",
      "ops": [],
      "settleMs": 500
    },
    {
      "id": "invoke_insert_above",
      "logicalAction": "activate the Insert above button; the engine commits it, then two restarts and a stale release",
      "ops": [
        {
          "id": "toolbar/insert",
          "op": "press"
        },
        {
          "contains": "insert-toolbar-1",
          "op": "waitEvent"
        },
        {
          "json": {
            "key": "insert-toolbar-1",
            "step": "release",
            "value": 0
          },
          "op": "stdin"
        },
        {
          "id": "row/F0000008-0000-4000-8000-000000000101/field",
          "op": "waitNode"
        },
        {
          "json": {
            "step": "toolbar-insert"
          },
          "op": "stdin"
        },
        {
          "contains": "insert-toolbar-2",
          "op": "waitEvent"
        },
        {
          "json": {
            "step": "toolbar-insert"
          },
          "op": "stdin"
        },
        {
          "contains": "insert-toolbar-3",
          "op": "waitEvent"
        },
        {
          "json": {
            "key": "insert-toolbar-2",
            "step": "release",
            "value": 0
          },
          "op": "stdin"
        },
        {
          "contains": "\"rejected\"",
          "op": "waitEvent"
        }
      ],
      "settleMs": 1500
    },
    {
      "id": "set_value_row3",
      "logicalAction": "set row 3 value to 'AX value' through the accessibility text-replacement route (Mac: AXSelectedText over a full AXSelectedTextRange, because SwiftUI ignores AXValue writes; Windows: ValuePattern.SetValue)",
      "ops": [
        {
          "id": "row/F0000008-0000-4000-8000-000000000003/field",
          "op": "replaceText",
          "value": "AX value"
        }
      ],
      "settleMs": 600
    },
    {
      "id": "focus_row3",
      "logicalAction": "focus row 3 field",
      "ops": [
        {
          "id": "row/F0000008-0000-4000-8000-000000000003/field",
          "op": "focus"
        }
      ],
      "settleMs": 400
    },
    {
      "id": "delete_row6",
      "logicalAction": "activate the Delete button of row 6",
      "ops": [
        {
          "afterId": "row/F0000008-0000-4000-8000-000000000006/field",
          "op": "press",
          "title": "Delete"
        },
        {
          "absent": true,
          "id": "row/F0000008-0000-4000-8000-000000000006/field",
          "op": "waitNode"
        }
      ],
      "settleMs": 800
    }
  ]
}
