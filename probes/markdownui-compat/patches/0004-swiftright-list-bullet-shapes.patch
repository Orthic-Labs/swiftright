diff --git a/Sources/MarkdownUI/Theme/BlockStyle/ListBullet.swift b/Sources/MarkdownUI/Theme/BlockStyle/ListBullet.swift
index a4f7c21..5d16bbc 100644
--- a/Sources/MarkdownUI/Theme/BlockStyle/ListBullet.swift
+++ b/Sources/MarkdownUI/Theme/BlockStyle/ListBullet.swift
@@ -1,6 +1,33 @@
 import SwiftUI
 
 struct ListBullet: View {
+  #if SWIFTRIGHT
+    // SwiftRight: the host paints only measured SF Symbols and "circle.fill" at this size is not in its table (the host refuses the whole frame),
+    // so the bullet is a shape. Measured on the Mac capture (markdown-basic-v1, scale 2.5, 13 pt body): a disc is 4 pt across (the symbol font size,
+    // round(13 / 3)) and its right edge sits 0.4 pt inside the marker box, which is the min-width (1.5 em) frame the marker style puts it in (run 39605245676: Mac disc right edge 99 px = 39.6 pt, box edge 40 pt).
+    private enum Kind { case disc, circle, square }
+    private let kind: Kind
+
+    var body: some View {
+      TextStyleAttributesReader { attributes in
+        let fontSize = attributes.fontProperties?.scaledSize ?? FontProperties.defaultSize
+        let side = round(fontSize / 3)
+        Group {
+          switch self.kind {
+          case .disc: Circle().fill(Color.primary)
+          case .circle: Circle().strokeBorder(Color.primary, lineWidth: max(0.5, side / 8))
+          case .square: Rectangle().fill(Color.primary)
+          }
+        }
+        .frame(width: side, height: side)
+        .padding(.trailing, 0.4)
+      }
+    }
+
+    static var disc: Self { .init(kind: .disc) }
+    static var circle: Self { .init(kind: .circle) }
+    static var square: Self { .init(kind: .square) }
+  #else
   private let image: Image
 
   var body: some View {
@@ -21,4 +48,5 @@ struct ListBullet: View {
   static var square: Self {
     .init(image: .init(systemName: "square.fill"))
   }
+  #endif
 }
