{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiftright.dev/factory/queue/v0.1/ticket.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "id", "provenance", "block", "dependencies", "status", "openedAt", "unit"],
  "properties": {
    "kind": {"const": "ticket"},
    "version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"},
    "block": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["id", "hash"], "properties": {"id": {"type": "string"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "bootstrapGroup": {"type": "string"},
    "recipe": {"$ref": "#/$defs/hashRef"},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/hashRef"}},
    "failingVerdicts": {"type": "array", "items": {"$ref": "#/$defs/hashRef"}},
    "status": {"enum": ["open", "claimed", "conflict", "expired", "closed", "blocked"]},
    "openedAt": {"type": "string", "format": "date-time"},
    "claim": {"type": "object", "required": ["owner", "claimedAt", "expiresAt"], "properties": {"owner": {"type": "string", "minLength": 1}, "claimedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
    "conflictWith": {"type": "array", "items": {"type": "string"}},
    "gateReceipt": {"type": "object", "required": ["id", "hash"], "properties": {"id": {"type": "string"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
    "lastExpiryReceipt": {"type": "string"},
    "lastClaimReceipt": {"type": "string"},
    "lastRenewalReceipt": {"type": "string"},
    "reportLink": {"type": "string"},
    "unit": {"const": true}
  },
  "$defs": {"hashRef": {"type": "object", "required": ["id", "hash"], "properties": {"id": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false}},
  "allOf": [
    {"if": {"properties": {"status": {"const": "claimed"}}}, "then": {"required": ["claim"]}},
    {"if": {"properties": {"status": {"const": "closed"}}}, "then": {"required": ["gateReceipt"]}}
  ]
}
