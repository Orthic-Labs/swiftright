+struct PreferenceContribution {
+    let apply: (inout PreferenceValues) -> Void
+
+    init<Key: PreferenceKey>(_ value: Key.Value, for key: Key.Type) {
+        apply = { values in values.reduce(value, for: key) }
+    }
