+            case .center: y = rect.minY + ySlack / 2
+            case .bottom: y = rect.minY + ySlack
+            }
+            place(child, in: LayoutRect(x: x, y: y, width: size.width, height: size.height), proposal: plan.proposals[index])
+        }
+    }
