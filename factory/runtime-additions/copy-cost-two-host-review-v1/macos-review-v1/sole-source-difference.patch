+/// Indirect immutable storage keeps additive metadata off every legacy snapshot.
+fileprivate final class ResolvedNodeAdditions: Equatable, Sendable {
+    let labelsHidden: Bool?
+    let toggleStyle: String?
+    let imageSizing: ResolvedImageSizing?
+    let color: ResolvedColor?
+    let shape: ResolvedShape?
+
+    init(labelsHidden: Bool?, toggleStyle: String?, imageSizing: ResolvedImageSizing?, color: ResolvedColor?, shape: ResolvedShape?) {
+        self.labelsHidden = labelsHidden
+        self.toggleStyle = toggleStyle
+        self.imageSizing = imageSizing
+        self.color = color
+        self.shape = shape
+    }
+
+    static func == (lhs: ResolvedNodeAdditions, rhs: ResolvedNodeAdditions) -> Bool {
+        lhs.labelsHidden == rhs.labelsHidden && lhs.toggleStyle == rhs.toggleStyle &&
+        lhs.imageSizing == rhs.imageSizing && lhs.color == rhs.color && lhs.shape == rhs.shape
     }
