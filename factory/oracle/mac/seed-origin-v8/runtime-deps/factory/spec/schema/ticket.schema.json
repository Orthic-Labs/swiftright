{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://swiftright.dev/factory/spec/v0.1/ticket.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "version", "id", "provenance", "block", "dependencies", "status", "openedAt"], "properties": {
    "kind": { "const": "ticket" }, "version": { "const": "0.1" }, "id": { "$ref": "common.schema.json#/$defs/id" }, "provenance": { "$ref": "common.schema.json#/$defs/provenance" }, "block": { "$ref": "common.schema.json#/$defs/id" }, "dependencies": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/hashRef" } }, "bootstrapGroup": { "type": "string" }, "status": { "enum": ["open", "claimed", "conflict", "expired", "closed", "blocked"] }, "openedAt": { "$ref": "common.schema.json#/$defs/rfc3339" }, "claim": { "type": "object", "additionalProperties": false, "required": ["owner", "claimedAt", "expiresAt"], "properties": { "owner": { "type": "string", "minLength": 1 }, "claimedAt": { "$ref": "common.schema.json#/$defs/rfc3339" }, "expiresAt": { "$ref": "common.schema.json#/$defs/rfc3339" } } }, "conflictWith": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } }, "waiver": { "$ref": "common.schema.json#/$defs/hashRef" }, "gateReceipt": { "$ref": "common.schema.json#/$defs/hashRef" } },
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }, { "if": { "properties": { "status": { "const": "claimed" } } }, "then": { "required": ["claim"] } }, { "if": { "properties": { "status": { "const": "closed" } } }, "then": { "required": ["gateReceipt"] } }]
}
