{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://swiftright.dev/factory/spec/v0.1/recipe.schema.json",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }], "type": "object", "additionalProperties": false,
  "required": ["kind", "version", "id", "provenance", "block", "witnesses", "stimuli", "assertions", "axes", "instrumentationTransparency"], "properties": {
    "kind": { "const": "recipe" }, "version": { "const": "0.1" }, "id": { "$ref": "common.schema.json#/$defs/id" }, "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "block": { "$ref": "common.schema.json#/$defs/id" }, "witnesses": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "sourceHash"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "sourceHash": { "$ref": "common.schema.json#/$defs/sha256" }, "resources": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/hashRef" } } } } },
    "stimuli": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "logicalAction"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "logicalAction": { "type": "string", "minLength": 1 }, "nativeMapping": { "type": "object", "additionalProperties": { "type": "string" } }, "nativeOnly": { "type": "boolean" } } } },
    "assertions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "channel", "expected"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "channel": { "type": "string" }, "expected": { "$ref": "common.schema.json#/$defs/canonicalValue" }, "observability": { "enum": ["available", "blocked"] } } } },
    "axes": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "values"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "values": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/canonicalValue" } }, "coverage": { "enum": ["pairwise", "full-product"] } } } }, "statefulSequences": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
    "negativeCases": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "mode"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "mode": { "enum": ["must-not-compile", "apple-behaviour"] }, "sourceHash": { "$ref": "common.schema.json#/$defs/sha256" } } } },
    "instrumentationTransparency": { "type": "object", "additionalProperties": false, "required": ["case", "channels"], "properties": { "case": { "$ref": "common.schema.json#/$defs/id" }, "channels": { "type": "array", "minItems": 1, "items": { "enum": ["layout", "paint"] } } } }
  }
}
