  "windowsCommand": "$ErrorActionPreference='Stop'; $transport=Join-Path $RepoRoot 'factory\\native\\windows\\settled-capture-adapter-v3\\transport\\adapter-count1'; if(Test-Path -LiteralPath $transport){throw 'Fresh adapter transport required'}; New-Item -ItemType Directory -Force -Path (Join-Path $transport 'archive')|Out-Null; Copy-Item -LiteralPath $AdapterInputsPath -Destination (Join-Path $transport 'inputs.json'); foreach($ref in $TransportManifest.requiredArchiveRefs){ $src=Join-Path $RepoRoot ($ref.path -replace '/','\\'); if(-not(Test-Path -LiteralPath $src -PathType Leaf)){throw ('Missing transport ref: '+$ref.path)}; $expected=($ref.sha256 -replace '^sha256:','').ToLowerInvariant(); $actual=(Get-FileHash -LiteralPath $src -Algorithm SHA256).Hash.ToLowerInvariant(); if($actual -cne $expected){throw ('Transport hash drift: '+$ref.path)}; $dst=Join-Path $transport.archive ($ref.path -replace '/','\\'); New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dst)|Out-Null; Copy-Item -LiteralPath $src -Destination $dst }; Compress-Archive -LiteralPath (Join-Path $transport 'inputs.json'),(Join-Path $transport 'archive') -DestinationPath (Join-Path $transport 'adapter-count1-transport.zip') -CompressionLevel Optimal -Force",
