  "reviewedFindings": [
    {
      "id": "strict-retained-kernel-certificate",
      "decision": "resolved",
      "evidence": "Shared outcome & coordinator certificate requires boolean confirmed/signal, integer0 wait result & exact permitted terminal status; missing/string/bool/float258/status controls use actual production predicate."
    },
    {
      "id": "pending-copy-destination-closure",
      "decision": "resolved-in-source",
      "evidence": "One retained managed background closure task per destination; no explicit flush when copy pending; caller wait5s, completed copy seal requires flush/close success & no expired deadline. Heldwriter64KiB test closes beforeEOF release & compares post-settlement exact bytes/hash."
    },
    {
      "id": "unclosed-destination-hash",
      "decision": "resolved",
      "evidence": "Capture & coordinator invoke shared Get-FactoryRawHash only through typed closed destination+closure result+completed task authority. Unclosed state produces null unqualified SHA & coordinator releaseAllowed=false persists across fallback. Production retained proof also independently requires exact two named closed stream states."
    },
    {
      "id": "timeout-control",
      "decision": "meaningful-prepared",
      "evidence": "Managed gate holds actual close thread;1ms deadline produces unclosed live/JSON-roundtripped states; injected hash callback remains0 for capture/coordinator. Gate release settles retained task, preserves deadlineExpired/unsealed state & allows closed diagnostic-partial hash only."
    },
    {
      "id": "snapshot-state",
      "decision": "resolved",
      "evidence": "Closure is detached via JSON snapshot; later retry/settlement does not mutate earlier before/receipt snapshots."
    }
  ],
