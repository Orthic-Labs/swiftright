{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://swiftright.dev/factory/spec/v0.1/capture.schema.json",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }], "type": "object", "additionalProperties": false,
  "required": ["kind", "version", "id", "provenance", "case", "platform", "tuple", "meta", "layout", "ax", "events", "anim", "images", "text"], "properties": {
    "kind": { "const": "capture" }, "version": { "const": "0.1" }, "id": { "$ref": "common.schema.json#/$defs/id" }, "provenance": { "$ref": "common.schema.json#/$defs/provenance" }, "case": { "$ref": "common.schema.json#/$defs/hashRef" }, "platform": { "enum": ["macos", "windows", "headless"] }, "tuple": { "$ref": "common.schema.json#/$defs/tuple" },
    "meta": { "type": "object", "additionalProperties": false, "required": ["run", "host", "conditions", "clock"], "properties": { "run": { "type": "integer", "minimum": 1 }, "host": { "$ref": "common.schema.json#/$defs/hashRef" }, "conditions": { "type": "object", "additionalProperties": { "$ref": "common.schema.json#/$defs/canonicalValue" } }, "clock": { "type": "object", "additionalProperties": false, "required": ["clockId", "correlationHash"], "properties": { "clockId": { "$ref": "common.schema.json#/$defs/id" }, "correlationHash": { "$ref": "common.schema.json#/$defs/sha256" } } } } },
    "layout": { "type": "array", "items": { "$ref": "#/$defs/layoutRecord" } }, "ax": { "type": "array", "items": { "$ref": "#/$defs/axNode" } }, "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }, "anim": { "type": "array", "items": { "$ref": "#/$defs/animation" } },
    "images": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "hash", "widthPx", "heightPx", "captureScale"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "hash": { "$ref": "common.schema.json#/$defs/sha256" }, "widthPx": { "type": "integer", "minimum": 1 }, "heightPx": { "type": "integer", "minimum": 1 }, "captureScale": { "$ref": "common.schema.json#/$defs/measuredNumber" }, "maskHash": { "$ref": "common.schema.json#/$defs/sha256" } } } }, "text": { "type": "array", "items": { "$ref": "#/$defs/textRun" } }
  },
  "$defs": {
    "rect": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "$ref": "common.schema.json#/$defs/measuredNumber" }, "y": { "$ref": "common.schema.json#/$defs/measuredNumber" }, "width": { "$ref": "common.schema.json#/$defs/measuredNumber" }, "height": { "$ref": "common.schema.json#/$defs/measuredNumber" } } },
    "proposal": { "type": "object", "additionalProperties": false, "properties": { "width": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/measuredNumber" }] }, "height": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/measuredNumber" }] } } },
    "layoutRecord": { "type": "object", "additionalProperties": false, "required": ["probeTag", "viewIdentity", "frame"], "properties": { "probeTag": { "type": "string" }, "viewIdentity": { "type": "string" }, "frame": { "$ref": "#/$defs/rect" }, "proposal": { "$ref": "#/$defs/proposal" }, "baseline": { "$ref": "common.schema.json#/$defs/measuredNumber" }, "alignment": { "type": "object", "additionalProperties": { "$ref": "common.schema.json#/$defs/measuredNumber" } } } },
    "axNode": { "type": "object", "additionalProperties": false, "required": ["identity", "role", "actions", "bounds", "source"], "properties": { "identity": { "type": "string" }, "role": { "type": "string" }, "label": { "type": "string" }, "value": { "$ref": "common.schema.json#/$defs/canonicalValue" }, "actions": { "type": "array", "items": { "type": "string" } }, "bounds": { "$ref": "#/$defs/rect" }, "source": { "enum": ["provider", "external"] }, "children": { "type": "array", "items": { "type": "string" } } } },
    "event": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "timeNs", "clockId"], "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "timeNs": { "type": "integer", "minimum": 0 }, "clockId": { "type": "string" }, "payload": { "$ref": "common.schema.json#/$defs/canonicalValue" } } },
    "animation": { "type": "object", "additionalProperties": false, "required": ["id", "stimulusTimeNs", "transactionTimeNs", "samples", "presentedFrames"], "properties": { "id": { "type": "string" }, "stimulusTimeNs": { "type": "integer" }, "transactionTimeNs": { "type": "integer" }, "samples": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["timeNs", "value"], "properties": { "timeNs": { "type": "integer" }, "value": { "$ref": "common.schema.json#/$defs/canonicalValue" } } } }, "presentedFrames": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["timeNs", "imageHash"], "properties": { "timeNs": { "type": "integer" }, "imageHash": { "$ref": "common.schema.json#/$defs/sha256" }, "dropped": { "type": "boolean" } } } } } },
    "textRun": { "type": "object", "additionalProperties": false, "required": ["text", "bounds", "baseline", "font", "colour"], "properties": { "text": { "type": "string" }, "bounds": { "$ref": "#/$defs/rect" }, "baseline": { "$ref": "common.schema.json#/$defs/measuredNumber" }, "font": { "type": "string" }, "colour": { "type": "string" }, "glyphBounds": { "type": "array", "items": { "$ref": "#/$defs/rect" } } } }
  }
}
