    {
      "journey_id": "navigation",
      "pilot_blocks": [
        "text",
        "scroll",
        "padding-frame"
      ],
      "extended_demands": [
        "sidebar selection state",
        "keyboard focus/roving selection",
        "command palette modal and focus trap",
        "navigation transitions"
      ],
      "service_dependencies": [
        "App-owned destination state; optional command registry and native bridge for menu/deep-link actions."
      ]
    },
    {
      "journey_id": "settings",
      "pilot_blocks": [
        "text",
        "scroll",
        "toggle",
        "disabled",
        "padding-frame"
      ],
      "extended_demands": [
        "TextField/control variety",
        "keyboard focus and navigation",
        "validation/errors",
        "async loading and external-change reconciliation",
        "settings storage/revision service"
      ],
      "service_dependencies": [
        "SettingsBackend load/patch/subscribe; Tauri-backed rightkit-settings adapter in production; section-specific adapters."
      ]
    },
    {
      "journey_id": "onboarding",
      "pilot_blocks": [
        "text",
        "scroll",
        "toggle",
        "disabled",
        "padding-frame"
      ],
      "extended_demands": [
        "ordered multi-step flow",
        "permission prompts",
        "download progress/cancel/retry",
        "legal modal/eligibility controls",
        "durable state + service sequencing"
      ],
      "service_dependencies": [
        "SettingsBackend; PermissionsBackend; ModelsBackend; optional LicenseBackend; optional app-owned LegalReceiptPort; callbacks."
      ]
    },
    {
      "journey_id": "media-playback",
      "pilot_blocks": [
        "image",
        "stack-overlay",
        "text",
        "padding-frame",
        "disabled"
      ],
      "extended_demands": [
        "HTML media element and codec recovery",
        "keyboard transport shortcuts",
        "fullscreen host API",
        "time/progress animation",
        "media conversion service"
      ],
      "service_dependencies": [
        "MediaAdapters resolveSrc/preparePlayback/cancelPlayback/setFullscreen; app owns playback preparation implementation and notification/log hooks."
      ]
    },
    {
      "journey_id": "image-view-edit",
      "pilot_blocks": [
        "image",
        "stack-overlay",
        "text",
        "scroll",
        "padding-frame"
      ],
      "extended_demands": [
        "canvas/image transform",
        "custom pointer gestures",
        "crop/text editing controls",
        "native open/save/print dialogs",
        "large resource lifecycle"
      ],
      "service_dependencies": [
        "MediaAdapters listImageSiblings/listSystemFonts/saveImage/printImage/acquireResource; app owns dialogs/filesystem writes."
      ]
    },
    {
      "journey_id": "pdf-reading",
      "pilot_blocks": [
        "image",
        "scroll",
        "text",
        "padding-frame",
        "disabled"
      ],
      "extended_demands": [
        "PDF.js worker/render pipeline",
        "document/file adapter",
        "find input and IME",
        "sidebar panels",
        "view-state persistence",
        "external-link policy"
      ],
      "service_dependencies": [
        "PdfSource supplied by host; optional openExternal adapter; host may persist PdfViewState."
      ]
    },
    {
      "journey_id": "legal-acceptance",
      "pilot_blocks": [
        "text",
        "scroll",
        "toggle",
        "disabled",
        "padding-frame"
      ],
      "extended_demands": [
        "document scroll/acknowledgement gating",
        "radio/checkbox controls",
        "receipt persistence/hash",
        "version policy",
        "quit/close action"
      ],
      "service_dependencies": [
        "App-owned acceptance receipt is truth when injected; onboarding SettingsBackend stores progress; external URL opener optional."
      ]
    },
    {
      "journey_id": "shortcuts",
      "pilot_blocks": [
        "text",
        "scroll",
        "padding-frame"
      ],
      "extended_demands": [
        "key event routing",
        "focus/IME behavior",
        "sequence timeout",
        "rebinding capture/conflict UX"
      ],
      "service_dependencies": [
        "ShortcutRegistry; platform resolver; persistence adapter for overrides supplied by app/settings integration."
      ]
    },
    {
      "journey_id": "tray-menu",
      "pilot_blocks": [
        "text"
      ],
      "extended_demands": [
        "native menu/tray lifecycle",
        "deep-link parsing/routing",
        "duplicate/window targeting policy"
      ],
      "service_dependencies": [
        "Optional AppShellBridge.onMenuAction; host Tauri menu/tray/deep-link adapters."
      ]
    },
    {
      "journey_id": "dialogs",
      "pilot_blocks": [
        "text",
        "stack-overlay",
        "padding-frame",
        "disabled"
      ],
      "extended_demands": [
        "modal stacking/focus restoration",
        "text entry/IME",
        "animation and dismiss interactions"
      ],
      "service_dependencies": [
        "ShellProvider dialog and command state; app supplies command callback."
      ]
    },
    {
      "journey_id": "persistence",
      "pilot_blocks": [
        "toggle",
        "text",
        "padding-frame"
      ],
      "extended_demands": [
        "storage adapters and cross-process consistency",
        "schema migration",
        "crash-safe atomic write"
      ],
      "service_dependencies": [
        "ThemeStorage/localStorage default; SettingsBackend/rightkit-settings; app-owned LegalReceiptPort; SliceApp RowStore (source evidence only)."
      ]
    },
    {
      "journey_id": "updates",
      "pilot_blocks": [
        "text",
        "scroll",
        "disabled",
        "padding-frame"
      ],
      "extended_demands": [
        "download/install progress",
        "update service/auth",
        "restart/recovery strategy",
        "platform installer and rollback"
      ],
      "service_dependencies": [
        "ViewRight update/license service and OS package replacement; dirty-document recovery guard."
      ]
    },
    {
      "journey_id": "recovery",
      "pilot_blocks": [
        "text",
        "disabled",
        "padding-frame"
      ],
      "extended_demands": [
        "error classification",
        "startup/window recovery",
        "document/session restoration",
        "diagnostics and logs"
      ],
      "service_dependencies": [
        "React error boundary; settings loader; app document saver/update recovery services."
      ]
    },
    {
      "journey_id": "slice-editor",
      "pilot_blocks": [
        "text",
        "scroll",
        "padding-frame"
      ],
      "extended_demands": [
        "TextField/FocusState",
        "List/ForEach/onMove",
        "Button actions",
        "Binding(get:set:)",
        "persistence"
      ],
      "service_dependencies": [
        "SliceApp EditorModel and RowStore persistence."
      ]
    }
