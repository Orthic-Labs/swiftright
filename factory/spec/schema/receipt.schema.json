{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://swiftright.dev/factory/spec/v0.1/receipt.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "version", "id", "provenance", "operation", "status", "tuple", "inputs", "outputs", "startedAt", "finishedAt"], "properties": {
    "kind": { "const": "receipt" }, "version": { "const": "0.1" }, "id": { "$ref": "common.schema.json#/$defs/id" }, "provenance": { "$ref": "common.schema.json#/$defs/provenance" }, "operation": { "enum": ["capture", "compare", "gate", "promotion", "host-op", "queue", "migration"] }, "status": { "enum": ["pass", "fail", "blocked", "partial", "resumed"] }, "tuple": { "$ref": "common.schema.json#/$defs/tuple" }, "inputs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/hashRef" } }, "outputs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/hashRef" } }, "startedAt": { "$ref": "common.schema.json#/$defs/rfc3339" }, "finishedAt": { "$ref": "common.schema.json#/$defs/rfc3339" }, "seed": { "type": "integer" }, "resumeOf": { "$ref": "common.schema.json#/$defs/hashRef" }, "resumeToken": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "migration": { "type": "object", "additionalProperties": false, "required": ["fromVersion", "toVersion", "original"], "properties": { "fromVersion": { "type": "string" }, "toVersion": { "type": "string" }, "original": { "$ref": "common.schema.json#/$defs/hashRef" } } }, "failure": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "evidence": { "$ref": "common.schema.json#/$defs/hashRef" } } } },
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }, { "if": { "properties": { "operation": { "const": "migration" } } }, "then": { "required": ["migration"] } }, { "if": { "properties": { "status": { "const": "resumed" } } }, "then": { "required": ["resumeOf", "resumeToken"] } }]
}
